{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LabBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::income-lab21-257719179516-us-east-1"
    },
    {
      "Sid": "LabDataAndModels",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::income-lab21-257719179516-us-east-1/dvc/*",
        "arn:aws:s3:::income-lab21-257719179516-us-east-1/artifacts/*"
      ]
    }
  ]
}
